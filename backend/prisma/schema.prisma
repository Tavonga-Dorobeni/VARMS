generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ZIMRA_OFFICER
  DEALER
  CVR_OFFICER
  FIU_ANALYST
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum DealerStatus {
  ACTIVE
  SUSPENDED
  REVOKED
}

enum VehicleStatus {
  CLEARED
  INVENTORY
  SOLD
  REGISTERED
  STR_FLAGGED
}

enum PaymentType {
  CASH
  BANK_TRANSFER
  FINANCE
}

enum StrSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum StrStatus {
  PENDING
  UNDER_REVIEW
  DISMISSED
  ESCALATED
}

enum RegistrationStatus {
  APPROVED
  BLOCKED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

model Dealer {
  id            Int               @id @default(autoincrement())
  name          String
  licenseNumber String            @unique(map: "uq_dealers_license_number") @map("license_number")
  status        DealerStatus      @default(ACTIVE)
  address       String
  contactInfo   String            @map("contact_info")
  approvedAt    DateTime          @map("approved_at")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  users         User[]
  vehicles      Vehicle[]
  sales         SaleTransaction[]
  strAlerts     StrAlert[]

  @@map("dealers")
}

model User {
  id            Int                  @id @default(autoincrement())
  fullName      String               @map("full_name")
  role          UserRole
  agency        String
  username      String               @unique(map: "uq_users_username")
  passwordHash  String               @map("password_hash")
  dealershipId  Int?                 @map("dealership_id")
  status        UserStatus           @default(ACTIVE)
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")
  dealership    Dealer?              @relation(fields: [dealershipId], references: [id])
  importRecords ImportRecord[]
  registrations RegistrationRecord[]
  auditLogs     AuditLog[]

  @@map("users")
}

model Vehicle {
  id              Int                  @id @default(autoincrement())
  vin             String               @unique(map: "uq_vehicles_vin")
  make            String
  model           String
  declaredValue   Decimal              @map("declared_value")
  countryOfOrigin String               @map("country_of_origin")
  importDate      DateTime             @map("import_date")
  dealershipId    Int                  @map("dealership_id")
  status          VehicleStatus
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")
  dealership      Dealer               @relation(fields: [dealershipId], references: [id])
  importRecords   ImportRecord[]
  sales           SaleTransaction[]
  strAlerts       StrAlert[]
  registrations   RegistrationRecord[]

  @@map("vehicles")
}

model ImportRecord {
  id         Int      @id @default(autoincrement())
  vehicleId  Int      @map("vehicle_id")
  officerId  Int      @map("officer_id")
  borderPost String   @map("border_post")
  timestamp  DateTime
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id])
  officer    User     @relation(fields: [officerId], references: [id])

  @@map("import_records")
}

model Buyer {
  id               Int                  @id @default(autoincrement())
  fullName         String               @map("full_name")
  nationalId       String               @unique(map: "uq_buyers_national_id") @map("national_id")
  contactDetails   String               @map("contact_details")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")
  sales            SaleTransaction[]
  beneficialOwners BeneficialOwner[]
  strAlerts        StrAlert[]
  registrations    RegistrationRecord[]

  @@map("buyers")
}

model SaleTransaction {
  id                 Int          @id @default(autoincrement())
  vehicleId          Int          @map("vehicle_id")
  dealershipId       Int          @map("dealership_id")
  buyerId            Int          @map("buyer_id")
  salePrice          Decimal      @map("sale_price")
  paymentType        PaymentType  @map("payment_type")
  proofOfPayment     String       @map("proof_of_payment")
  saleDate           DateTime     @map("sale_date")
  isActingForAnother Boolean      @default(false) @map("is_acting_for_another")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")
  vehicle            Vehicle      @relation(fields: [vehicleId], references: [id])
  dealership         Dealer       @relation(fields: [dealershipId], references: [id])
  buyer              Buyer        @relation(fields: [buyerId], references: [id])

  @@map("sale_transactions")
}

model BeneficialOwner {
  id               Int      @id @default(autoincrement())
  linkedBuyerId    Int      @map("linked_buyer_id")
  fullName         String   @map("full_name")
  nationalId       String   @map("national_id")
  relationshipType String   @map("relationship_type")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  buyer            Buyer    @relation(fields: [linkedBuyerId], references: [id])

  @@map("beneficial_owners")
}

model StrAlert {
  id               Int         @id @default(autoincrement())
  alertType        String      @map("alert_type")
  sourceRecordId   Int         @map("source_record_id")
  sourceEntityType String      @map("source_entity_type")
  reason           String
  severity         StrSeverity
  status           StrStatus   @default(PENDING)
  vehicleId        Int?        @map("vehicle_id")
  dealershipId     Int?        @map("dealership_id")
  buyerId          Int?        @map("buyer_id")
  transactionValue Decimal?    @map("transaction_value")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")
  vehicle          Vehicle?    @relation(fields: [vehicleId], references: [id])
  dealership       Dealer?     @relation(fields: [dealershipId], references: [id])
  buyer            Buyer?      @relation(fields: [buyerId], references: [id])

  @@map("str_alerts")
}

model RegistrationRecord {
  id               Int                @id @default(autoincrement())
  vehicleId        Int                @map("vehicle_id")
  buyerId          Int                @map("buyer_id")
  officerId        Int                @map("officer_id")
  registrationDate DateTime           @map("registration_date")
  status           RegistrationStatus
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  vehicle          Vehicle            @relation(fields: [vehicleId], references: [id])
  buyer            Buyer              @relation(fields: [buyerId], references: [id])
  officer          User               @relation(fields: [officerId], references: [id])

  @@map("registration_records")
}

model AuditLog {
  id          Int         @id @default(autoincrement())
  userId      Int         @map("user_id")
  role        String
  action      AuditAction
  entityType  String      @map("entity_type")
  entityId    Int         @map("entity_id")
  beforeValue Json?       @map("before_value")
  afterValue  Json?       @map("after_value")
  reason      String?
  timestamp   DateTime
  createdAt   DateTime    @default(now()) @map("created_at")
  user        User        @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model IdempotencyKey {
  id             Int      @id @default(autoincrement())
  userId         Int?     @map("user_id")
  route          String
  method         String
  idempotencyKey String   @map("idempotency_key")
  responseCode   Int      @map("response_code")
  responseBody   Json     @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([userId, route, method, idempotencyKey], map: "uq_idempotency_request")
  @@map("idempotency_keys")
}
